<Page x:Class="ThemeStudio.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:ThemeStudio"
      Background="{ThemeResource BackgroundBrush}">
    <Grid x:Name="LayoutRoot"
          RowDefinitions="Auto,*,Auto"
          SizeChanged="OnLayoutSizeChanged">
        <Grid x:Name="TopBar"
              Padding="24,14"
              ColumnDefinitions="Auto,*,Auto"
              Background="{ThemeResource SurfaceBrush}"
              BorderBrush="{ThemeResource OutlineVariantBrush}"
              BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Border Width="30"
                        Height="30"
                        Background="{ThemeResource PrimaryBrush}"
                        CornerRadius="9">
                    <TextBlock Text="f"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{ThemeResource OnPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,-4,0,0" />
                </Border>
                <TextBlock Text="forma"
                           Style="{StaticResource TitleLarge}" />
                <TextBlock x:Name="StudioLabel"
                           Text="/  theme studio"
                           Style="{StaticResource BodyMedium}"
                           Foreground="{ThemeResource OnSurfaceVariantBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button FontSize="{ThemeResource LabelLargeFontSize}"
                        x:Name="AppearanceButton"
                        Content="Dark mode"
                        Style="{StaticResource TextButtonStyle}"
                        Click="OnAppearanceClick" />
                <Button FontSize="{ThemeResource LabelLargeFontSize}"
                        x:Name="PanelButton"
                        Content="Design panel"
                        Style="{StaticResource FilledTonalButtonStyle}"
                        Click="OnPanelClick"
                        AutomationProperties.Name="Toggle design panel" />
            </StackPanel>
        </Grid>
        <Grid x:Name="Workspace"
              Grid.Row="1"
              ColumnDefinitions="180,*,320"
              RowDefinitions="Auto,*">
            <Border x:Name="NavigationRail"
                    Grid.RowSpan="2"
                    Background="{ThemeResource SurfaceBrush}"
                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16,28">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Text="WORKSPACE"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                   Margin="12,0,0,14" />
                        <Button FontSize="{ThemeResource LabelLargeFontSize}"
                                x:Name="OverviewNav"
                                Content="Overview"
                                Tag="Overview"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource TextButtonStyle}"
                                Click="OnNavigate" />
                        <Button FontSize="{ThemeResource LabelLargeFontSize}"
                                x:Name="ProjectsNav"
                                Content="Projects"
                                Tag="Projects"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource TextButtonStyle}"
                                Click="OnNavigate" />
                        <Button FontSize="{ThemeResource LabelLargeFontSize}"
                                x:Name="SettingsNav"
                                Content="Settings"
                                Tag="Settings"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource TextButtonStyle}"
                                Click="OnNavigate" />
                        <Border Height="1"
                                Background="{ThemeResource OutlineVariantBrush}"
                                Margin="8,16" />
                        <TextBlock Text="THE PLAYGROUND"
                                   Style="{StaticResource LabelSmall}"
                                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                   Margin="12,0,0,8" />
                        <Button FontSize="{ThemeResource LabelLargeFontSize}"
                                x:Name="TokensNav"
                                Content="Lab"
                                Tag="Semantic lab"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource TextButtonStyle}"
                                Click="OnNavigate" />
                    </StackPanel>
                    <StackPanel Grid.Row="2"
                                Spacing="10">
                        <Border Background="{ThemeResource SecondaryContainerBrush}"
                                CornerRadius="12"
                                Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="One UI. Two themes."
                                           Style="{StaticResource LabelLarge}"
                                           Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                                <TextBlock Text="A new look, with the same semantic language."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource BodySmall}"
                                           Foreground="{ThemeResource OnSecondaryContainerBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="AM   Alex Morgan"
                                   Style="{StaticResource LabelMedium}"
                                   Margin="8" />
                    </StackPanel>
                </Grid>
            </Border>
            <ComboBox x:Name="CompactNavigation"
                      Grid.Column="1"
                      Visibility="Collapsed"
                      Margin="16,12"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnCompactNavigate"
                      AutomationProperties.Name="Page">
                <x:String>Overview</x:String>
                <x:String>Projects</x:String>
                <x:String>Settings</x:String>
                <x:String>Semantic lab</x:String>
            </ComboBox>
            <ScrollViewer x:Name="ContentScroll"
                          Grid.Row="1"
                          Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="PageContent"
                                Padding="{ThemeResource Space800Thickness}"
                                HorizontalContentAlignment="Stretch" />
            </ScrollViewer>
            <Border x:Name="InspectorBorder"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Background="{ThemeResource SurfaceBrush}"
                    BorderBrush="{ThemeResource OutlineVariantBrush}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <local:DesignPanel x:Name="Inspector" />
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="2"
              Padding="20,8"
              ColumnDefinitions="*,Auto"
              Background="{ThemeResource SurfaceBrush}"
              BorderBrush="{ThemeResource OutlineVariantBrush}"
              BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}"
                       Style="{StaticResource BodySmall}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="ThemeLabel"
                       Grid.Column="1"
                       Style="{StaticResource LabelSmall}"
                       Foreground="{ThemeResource PrimaryBrush}"
                       Margin="12,0,0,0" />
        </Grid>
    </Grid>
</Page>
